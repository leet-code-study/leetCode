class Solution {
    public int lenLongestFibSubseq(int[] arr) {
        int n = arr.length;

        Map<Integer, Integer> indexMap = new HashMap<>();

        for (int i = 0; i < n; i++) {
            indexMap.put(arr[i], i);
        }

        int[][] dp = new int[n][n];

        int answer = 0;

        for (int j = 0; j < n; j++) {

            for (int k = j + 1; k < n; k++) {

                int previous = arr[k] - arr[j];

                Integer i = indexMap.get(previous);

                if (i != null && i < j) {
                    dp[j][k] = dp[i][j] + 1;
                    answer = Math.max(answer, dp[j][k]);
                }
            }
        }

        return answer == 0 ? 0 : answer + 2;
    }
}
