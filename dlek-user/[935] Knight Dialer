class Solution {
    public int knightDialer(int n) {
        final int MOD = 1_000_000_007;

        int[][] moves = {
            {4, 6},       // 0
            {6, 8},       // 1
            {7, 9},       // 2
            {4, 8},       // 3
            {0, 3, 9},    // 4
            {},           // 5
            {0, 1, 7},   // 6
            {2, 6},       // 7
            {1, 3},       // 8
            {2, 4}        // 9
        };

        long[] dp = new long[10];

        for (int i = 0; i < 10; i++) {
            dp[i] = 1;
        }

        for (int length = 2; length <= n; length++) {
            long[] next = new long[10];

            for (int num = 0; num < 10; num++) {

                for (int prev : moves[num]) {
                    next[num] = (next[num] + dp[prev]) % MOD;
                }
            }

            dp = next;
        }

        long answer = 0;

        for (int num = 0; num < 10; num++) {
            answer = (answer + dp[num]) % MOD;
        }

        return (int) answer;
    }
}
