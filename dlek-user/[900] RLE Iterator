class RLEIterator {
    private int[] encoded;
    private int index;

    public RLEIterator(int[] encoded) {
        this.encoded = encoded;
        this.index = 0;
    }

    public int next(int n) {
        while (index < encoded.length) {
            if (encoded[index] >= n) {
                encoded[index] -= n;
                return encoded[index + 1];
            }

            n -= encoded[index];
            index += 2;
        }

        return -1;
    }
}

