class Solution {
    public int numFriendRequests(int[] ages) {
        Arrays.sort(ages);

        int n = ages.length;

        int left = 0;
        int right = 0;
        int answer = 0;

        for (int age : ages) {

            if (age < 15) {
                continue;
            }

            while (ages[left] <= age / 2 + 7) {
                left++;
            }

            while (right + 1 < n && ages[right + 1] <= age) {
                right++;
            }

            answer += right - left;
        }

        return answer;
    }
}
