class Solution {
    public int minFlipsMonoIncr(String s) {
        int dpZero = 0;
        int dpOne = 0;

        for (char c : s.toCharArray()) {
            if (c == '0') {
                dpOne = Math.min(dpZero, dpOne + 1);
            } else {
                dpZero++;
                dpOne = Math.min(dpZero - 1, dpOne);
            }
        }

        return Math.min(dpZero, dpOne);
    }
}
