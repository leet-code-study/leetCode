class Solution {
    public int flipgame(int[] fronts, int[] backs) {
        Set<Integer> bad = new HashSet<>();

        int n = fronts.length;

        for (int i = 0; i < n; i++) {
            if (fronts[i] == backs[i]) {
                bad.add(fronts[i]);
            }
        }

        int answer = Integer.MAX_VALUE;

        for (int num : fronts) {
            if (!bad.contains(num)) {
                answer = Math.min(answer, num);
            }
        }

        for (int num : backs) {
            if (!bad.contains(num)) {
                answer = Math.min(answer, num);
            }
        }

        return answer == Integer.MAX_VALUE ? 0 : answer;
    }
}
