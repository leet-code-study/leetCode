class Solution {
    public int numMagicSquaresInside(int[][] grid) {
        int row = grid.length;
        int col = grid[0].length;

        int answer = 0;

        for (int r = 0; r <= row - 3; r++) {
            for (int c = 0; c <= col - 3; c++) {

                if (isMagicSquare(grid, r, c)) {
                    answer++;
                }
            }
        }

        return answer;
    }

    private boolean isMagicSquare(int[][] grid, int r, int c) {
        boolean[] visited = new boolean[10];

        for (int i = r; i < r + 3; i++) {
            for (int j = c; j < c + 3; j++) {

                int num = grid[i][j];

                if (num < 1 || num > 9) {
                    return false;
                }

                if (visited[num]) {
                    return false;
                }

                visited[num] = true;
            }
        }

        for (int i = r; i < r + 3; i++) {
            int sum = 0;

            for (int j = c; j < c + 3; j++) {
                sum += grid[i][j];
            }

            if (sum != 15) {
                return false;
            }
        }

        for (int j = c; j < c + 3; j++) {
            int sum = 0;

            for (int i = r; i < r + 3; i++) {
                sum += grid[i][j];
            }

            if (sum != 15) {
                return false;
            }
        }

        int diagonal1 =
                grid[r][c]
                + grid[r + 1][c + 1]
                + grid[r + 2][c + 2];

        if (diagonal1 != 15) {
            return false;
        }

        int diagonal2 =
                grid[r][c + 2]
                + grid[r + 1][c + 1]
                + grid[r + 2][c];

        if (diagonal2 != 15) {
            return false;
        }

        return true;
    }
}
