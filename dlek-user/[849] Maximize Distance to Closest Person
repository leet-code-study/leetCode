class Solution {
    public int maxDistToClosest(int[] seats) {
        int maxDistance = 0;
        int prevPerson = -1;

        for (int i = 0; i < seats.length; i++) {
            if (seats[i] == 1) {
                if (prevPerson == -1) {
                    maxDistance = i;
                } else {
                    maxDistance = Math.max(
                        maxDistance,
                        (i - prevPerson) / 2
                    );
                }

                prevPerson = i;
            }
        }

        maxDistance = Math.max(
            maxDistance,
            seats.length - 1 - prevPerson
        );

        return maxDistance;
    }
}
