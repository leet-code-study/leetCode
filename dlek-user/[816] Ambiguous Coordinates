class Solution {
    public List<String> ambiguousCoordinates(String s) {
        List<String> answer = new ArrayList<>();

        s = s.substring(1, s.length() - 1);

        int n = s.length();

        for (int i = 1; i < n; i++) {

            List<String> left = generate(s.substring(0, i));
            List<String> right = generate(s.substring(i));

            for (String l : left) {
                for (String r : right) {
                    answer.add("(" + l + ", " + r + ")");
                }
            }
        }

        return answer;
    }

    private List<String> generate(String str) {

        List<String> list = new ArrayList<>();

        int n = str.length();

        if (isValidInteger(str)) {
            list.add(str);
        }

        for (int i = 1; i < n; i++) {

            String left = str.substring(0, i);
            String right = str.substring(i);

            if (isValidInteger(left) &&
                isValidDecimal(right)) {

                list.add(left + "." + right);
            }
        }

        return list;
    }

    private boolean isValidInteger(String s) {

        if (s.length() == 1) {
            return true;
        }

        return s.charAt(0) != '0';
    }

    private boolean isValidDecimal(String s) {

        return s.charAt(s.length() - 1) != '0';
    }
}
